--- a/gdk/win32/gdkmonitor-win32.c
+++ b/gdk/win32/gdkmonitor-win32.c
@@ -760,6 +760,53 @@
       prune_monitors (&data);
     }
 
+  if (data.monitors->len == 0)
+    {
+      /* Both passes produced nothing, e.g. a remote session whose display
+       * adapter is not attached to the desktop: fabricate a monitor that
+       * covers the Win32 virtual screen. Otherwise the display reports
+       * zero monitors, which code paths such as popup layout dereference.
+       */
+      GdkWin32Monitor *w32mon;
+      GdkMonitor *mon;
+      GdkRectangle rect;
+      int scale;
+      int x, y, width, height;
+
+      x = GetSystemMetrics (SM_XVIRTUALSCREEN);
+      y = GetSystemMetrics (SM_YVIRTUALSCREEN);
+      width = GetSystemMetrics (SM_CXVIRTUALSCREEN);
+      height = GetSystemMetrics (SM_CYVIRTUALSCREEN);
+      if (width <= 0 || height <= 0)
+        {
+          x = 0;
+          y = 0;
+          width = GetSystemMetrics (SM_CXSCREEN);
+          height = GetSystemMetrics (SM_CYSCREEN);
+        }
+
+      scale = gdk_win32_display_get_monitor_scale_factor (win32_display,
+                                                          NULL, NULL);
+
+      w32mon = g_object_new (GDK_TYPE_WIN32_MONITOR,
+                             "display", win32_display, NULL);
+      w32mon->madeup = TRUE;
+      w32mon->remove = FALSE;
+      w32mon->work_rect.x = x / scale;
+      w32mon->work_rect.y = y / scale;
+      w32mon->work_rect.width = width / scale;
+      w32mon->work_rect.height = height / scale;
+      g_ptr_array_add (data.monitors, w32mon);
+
+      mon = GDK_MONITOR (w32mon);
+      gdk_monitor_set_scale_factor (mon, scale);
+      rect.x = x / scale;
+      rect.y = y / scale;
+      rect.width = width / scale;
+      rect.height = height / scale;
+      gdk_monitor_set_geometry (mon, &rect);
+    }
+
   return data.monitors;
 }
 
