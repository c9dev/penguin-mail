#!/bin/sh
# Starts Penguin Mail inside the snap with its libraries' data found in the
# snap rather than in the base, which has no GTK. snapcraft.yaml runs this
# before the app.
arch=x86_64-linux-gnu

export XDG_DATA_DIRS="$SNAP/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
export GSETTINGS_SCHEMA_DIR="$SNAP/usr/share/glib-2.0/schemas"
export GIO_MODULE_DIR="$SNAP/usr/lib/$arch/gio/modules"
export LD_LIBRARY_PATH="$SNAP/usr/lib/$arch:$SNAP/usr/lib/$arch/webkitgtk-6.0/injected-bundle${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

# Fontconfig reads the snap's own rules, as snapcraft's gnome extension
# does. The host's /etc/fonts links its rules into a /usr the snap cannot
# see, and without them "sans-serif" falls on any font. snap/local/fonts.conf
# says why. The file below adds what only the launcher knows: the person's
# own font folders, and a cache every revision shares. conf.d/50-user.conf
# reads it from $XDG_CONFIG_HOME.
export FONTCONFIG_PATH="$SNAP/etc/fonts"
export FONTCONFIG_FILE="$SNAP/etc/fonts/penguin-mail.conf"
xml_path() {
    printf '%s' "$1" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'
}
fontconfig_user="${XDG_CONFIG_HOME:-$HOME/.config}/fontconfig"
mkdir -p "$fontconfig_user" "$SNAP_USER_COMMON/fontconfig"
{
    echo '<?xml version="1.0"?>'
    echo '<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">'
    echo '<!-- Written by the snap launcher at each start. -->'
    echo '<fontconfig>'
    echo "  <dir>$(xml_path "$SNAP_REAL_HOME/.local/share/fonts")</dir>"
    echo "  <dir>$(xml_path "$SNAP_REAL_HOME/.fonts")</dir>"
    echo "  <cachedir>$(xml_path "$SNAP_USER_COMMON/fontconfig")</cachedir>"
    echo '</fontconfig>'
} > "$fontconfig_user/fonts.conf.new" && mv "$fontconfig_user/fonts.conf.new" "$fontconfig_user/fonts.conf"
# gpg and gpgsm keep a keyring of their own inside the snap, since the
# store would not let the snap open ~/.gnupg. gpg refuses a home that
# anyone but its owner can read, so a new one starts at mode 700. It lives
# in $SNAP_USER_COMMON, which every revision shares: snapd keeps
# $SNAP_USER_DATA per revision, so a revert would hide keys imported since
# the refresh. A keyring an earlier release made there moves across once.
export GNUPGHOME="$SNAP_USER_COMMON/.gnupg"
if [ ! -d "$GNUPGHOME" ]; then
    if [ -d "$SNAP_USER_DATA/.gnupg" ]; then
        cp -a "$SNAP_USER_DATA/.gnupg" "$GNUPGHOME"
    else
        mkdir -m 700 "$GNUPGHOME"
    fi
fi

exec "$@"
