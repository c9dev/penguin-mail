[Desktop Entry]
Type=Application
Name=Penguin Mail
GenericName=Mail
Comment=Read and write Gmail from all your accounts
Exec=penguin-mail %u
Icon=io.github.c9dev.PenguinMail
Terminal=false
Categories=Network;Email;GTK;GNOME;
Keywords=mail;email;gmail;inbox;
MimeType=x-scheme-handler/mailto;
StartupNotify=true
StartupWMClass=io.github.c9dev.PenguinMail
Actions=compose;

[Desktop Action compose]
Name=New Message
Exec=penguin-mail --compose
