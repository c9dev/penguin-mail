msgstr "Отметить прочитанным"

#: sync/src/triage.rs:54
msgid "Mark unread"
msgstr "Отметить непрочитанным"

#: sync/src/triage.rs:55
msgid "Star"
msgstr "Поставить звезду"

#: sync/src/triage.rs:56
msgid "Unstar"
msgstr "Снять звезду"

