"  --version      in phiên bản rồi thoát\n"
"  --background   khởi động trong khay hệ thống, không mở cửa sổ\n"
"  --demo         mở thư mẫu trong kho tạm; không đồng bộ\n"
"  --compose      mở thư mới, gửi đến ADDRESS nếu được cung cấp\n"
"  mailto:...     giống --compose mailto:...\n"
"  FILE.ics       mở tệp lịch để thêm các sự kiện vào lịch"

