msgid "Change {service} settings"
msgstr "Змінювати налаштування {service}"

#: app/src/permission.rs:279
msgid "Rules and automatic reply"
msgstr "Правила та автовідповідь"

#: app/src/permission.rs:282
msgid "Change Gmail settings"
msgstr "Змінювати налаштування Gmail"

#: app/src/permission.rs:283
msgid "Rules, automatic reply, send-as addresses"
msgstr "Правила, автовідповідь, адреси для надсилання від імені"

#: app/src/permission.rs:286
