msgstr "Остаточно вилучати пошту"

#: app/src/permission.rs:287
msgid "Emptying the trash and spam"
msgstr "Очищення смітника та спаму"

#: app/src/permission.rs:290
msgid "Read contacts"
msgstr "Читати контакти"

#: app/src/permission.rs:291
msgid "Names and photos as you write"
msgstr "Імена та фото під час написання"

#: app/src/permission.rs:294
msgid "Add and change contacts"
msgstr "Додавати та змінювати контакти"

#: app/src/permission.rs:295
msgid "Saving a sender as a contact"
msgstr "Збереження відправника як контакту"

#: app/src/permission.rs:298
msgid "Use the calendar"
msgstr "Користуватися календарем"

#: app/src/permission.rs:299
msgid "Events, invitations, reminders"
msgstr "Події, запрошення, нагадування"

#: app/src/permission.rs:302
msgid "Manage calendars"
msgstr "Керувати календарями"

#: app/src/permission.rs:303
msgid "New calendars, colors, subscriptions"
msgstr "Нові календарі, кольори, підписки"

#: app/src/permission.rs:306
msgid "Add files to Google Drive"
msgstr "Додавати файли на Google Drive"

#: app/src/permission.rs:307
