msgstr "Das Label konnte nicht gelöscht werden: {reason}"

#: app/src/offered.rs:462
msgid "Could not delete the folder: {reason}"
msgstr "Der Ordner konnte nicht gelöscht werden: {reason}"

#: app/src/offered.rs:469
msgid "This account has no labels yet."
msgstr "Dieses Konto hat noch keine Labels."

#: app/src/offered.rs:470
msgid "This account has no folders yet."
msgstr "Dieses Konto hat noch keine Ordner."

#: app/src/offered.rs:486
msgid "Your organization does not allow Penguin Mail to use this calendar."
msgstr ""
"Ihre Organisation erlaubt Penguin Mail nicht, diesen Kalender zu verwenden."

#: app/src/offered.rs:489
