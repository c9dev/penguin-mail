msgid "A calendar account named {name} is already here, for the server at {address}. Remove it to add this server under that name."
msgstr "A calendar account named {name} is already here, for the server at {address}. Remove it to add this server under that name."

#: sync/src/sign_in.rs:559
msgid "A calendar account named {name} is already here, signed in to this server as {user}. Type {user} to sign it in again, or remove it to sign in as someone else."
msgstr "A calendar account named {name} is already here, signed in to this server as {user}. Type {user} to sign it in again, or remove it to sign in as someone else."

#: sync/src/sign_in.rs:568
msgid "Sign In Again keeps {name} on the server at {address}. To use another server or user name, add it as a calendar account of its own."
msgstr "Sign In Again keeps {name} on the server at {address}. To use another server or user name, add it as a calendar account of its own."

#: sync/src/sign_in/browser.rs:90
msgid "This address is already in Penguin Mail."
msgstr "This address is already in Penguin Mail."

#. The JMAP server publishes no sign-in a browser can run.
#: sync/src/sign_in/browser.rs:116
msgid "This server does not offer a sign-in in the browser."
msgstr "This server does not offer a sign-in in the browser."

#: sync/src/sign_in/browser.rs:123
msgid "The server did not let Penguin Mail stay signed in. Sign in with a password or a token instead."
msgstr "The server did not let Penguin Mail stay signed in. Sign in with a password or a token instead."

#. Nobody came back from the browser within the wait.
#: sync/src/sign_in/browser.rs:138
msgid "Gave up waiting for the browser after ten minutes."
msgstr "Gave up waiting for the browser after ten minutes."

#: sync/src/sign_in/browser.rs:151
msgid "Penguin Mail can't find your Google project on this computer. Give it the key again to sign in."
msgstr "Penguin Mail can't find your Google project on this computer. Give it the key again to sign in."

#: sync/src/sign_in/browser.rs:163
msgid "This copy of Penguin Mail was built without Google sign-in. Get a release from github.com/c9dev/penguin-mail/releases."
msgstr "This copy of Penguin Mail was built without Google sign-in. Get a release from github.com/c9dev/penguin-mail/releases."

#: sync/src/sign_in/browser.rs:176
msgid "You signed in as {account}. Choose {wanted} to reconnect that account."
msgstr "You signed in as {account}. Choose {wanted} to reconnect that account."

#: sync/src/sign_in/browser.rs:186
msgid "Penguin Mail cannot work without access to your mail. Sign in again and leave the Gmail permission ticked."
msgstr "Penguin Mail cannot work without access to your mail. Sign in again and leave the Gmail permission ticked."

#: sync/src/sign_in/browser.rs:196
msgid "Your organization's administrator must approve Penguin Mail."
msgstr "Your organisation's administrator must approve Penguin Mail."

#: sync/src/sign_in/browser.rs:199
msgid "Penguin Mail cannot work without access to your mail. Sign in again and allow it."
msgstr "Penguin Mail cannot work without access to your mail. Sign in again and allow it."

#. Translators: "Online Accounts" is the name GNOME and Linux Mint show for this window; use the name your desktop shows in your language. Google is a name"
#: sync/src/sign_in/goa_link.rs:37
msgid "Online Accounts couldn't sign in to Google. Sign in again there."
msgstr "Online Accounts couldn't sign in to Google. Sign in again there."

#. Translators: "Online Accounts" is the name GNOME and Linux Mint show for this window; use the name your desktop shows in your language"
#: sync/src/sign_in/goa_link.rs:42
msgid "Mail is turned off for this account in Online Accounts."
msgstr "Mail is turned off for this account in Online Accounts."

#: sync/src/sign_in/own_client.rs:87
msgid "{set} is set but {missing} is not. Set both to sign in with your own Google client, or neither to use Penguin Mail's."
msgstr "{set} is set but {missing} is not. Set both to sign in with your own Google client, or neither to use Penguin Mail's."

#. This is a button on Google's page; use the words Google's page shows in your language.
#: sync/src/sign_in/own_client.rs:187
msgid "This key is for a website. Go back to step 5 and choose Desktop app."
msgstr "This key is for a website. Go back to step 5 and choose Desktop app."

#: sync/src/sign_in/own_client.rs:189
msgid "This isn't the file from step 5."
msgstr "This isn't the file from step 5."

#: sync/src/sign_in/own_client.rs:191
msgid "This file has no secret. Make a new key in step 5 and download it straight away."
msgstr "This file has no secret. Make a new key in step 5 and download it straight away."

#. This is a button on Google's page; use the words Google's page shows in your language.
#: sync/src/sign_in/own_client.rs:195
msgid "Paste both the Client ID and the Client secret"
msgstr "Paste both the Client ID and the Client secret"

#. This is a button on Google's page; use the words Google's page shows in your language.
#: sync/src/sign_in/own_client.rs:199
msgid "Copy the Client ID from step 5 again. It ends in .apps.googleusercontent.com."
msgstr "Copy the Client ID from step 5 again. It ends in .apps.googleusercontent.com."

#. Translators: said under the key file a person chose in the Google project setup.
#: sync/src/sign_in/own_client.rs:202
msgid "Penguin Mail can't open this file. Choose another."
msgstr "Penguin Mail can't open this file. Choose another."

