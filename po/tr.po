#: app/data/io.github.c9dev.PenguinMail.metainfo.xml:85
msgid "All your accounts in one inbox, with a reply open"
msgstr "Yanıt penceresi açıkken tüm hesaplarınız tek gelen kutusunda"

#: app/data/io.github.c9dev.PenguinMail.metainfo.xml:89
msgid "The same inbox in dark mode"
msgstr "Aynı gelen kutusu koyu kipte"

#: app/data/io.github.c9dev.PenguinMail.metainfo.xml:93
msgid "The calendar's week, with working hours and where you work"
msgstr "Çalışma saatleri ve çalışma konumuyla takvimin hafta görünümü"

#: app/data/io.github.c9dev.PenguinMail.metainfo.xml:97
msgid "An invitation in a message, with the hours around the meeting"
msgstr "Toplantının öncesindeki ve sonrasındaki saatlerle ileti içindeki davet"

#: app/data/io.github.c9dev.PenguinMail.metainfo.xml:101
msgid "Replying, with the quoted history folded away"
msgstr "Alıntılanan geçmiş daraltılmışken yanıtlama"

#: app/data/io.github.c9dev.PenguinMail.metainfo.xml:105
msgid "The assistant beside your mail"
msgstr "Postanızın yanındaki asistan"

