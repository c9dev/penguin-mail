msgstr "{host}는 서버 이름이 아닙니다."

#: app/src/add_account.rs:1197
msgid "Type the incoming server's name."
msgstr "수신 서버 이름을 입력하세요."

#: app/src/add_account.rs:1198
msgid "Type the outgoing server's name."
msgstr "발신 서버 이름을 입력하세요."

