msgid "{provider} refused the token"
msgstr "Το {provider} απέρριψε το διακριτικό"

#: app/src/add_account.rs:2049
msgid "Check the token and the access it was made with, then choose Sign In."
msgstr ""
"Ελέγξτε το διακριτικό και την πρόσβαση με την οποία δημιουργήθηκε και "
"επιλέξτε «Σύνδεση»."

#: app/src/add_account.rs:2058
msgid "The token holds a character that cannot be sent"
msgstr "Το διακριτικό περιέχει χαρακτήρα που δεν μπορεί να σταλεί"

#: app/src/add_account.rs:2059
msgid "The password holds a character that cannot be sent"
msgstr "Ο κωδικός περιέχει χαρακτήρα που δεν μπορεί να σταλεί"

#: app/src/add_account.rs:2061
msgid "Paste it again without the line break, then choose Sign In."
msgstr "Επικολλήστε τον ξανά χωρίς την αλλαγή γραμμής και επιλέξτε «Σύνδεση»."

#: app/src/add_account.rs:2065
msgid "No JMAP server at {host}"
msgstr "Δεν υπάρχει διακομιστής JMAP στο {host}"

#: app/src/add_account.rs:2069
msgid "Check the session URL in Server Settings, or use IMAP instead."
msgstr ""
"Ελέγξτε το URL συνεδρίας στις «Ρυθμίσεις διακομιστή» ή χρησιμοποιήστε IMAP."

#: app/src/add_account.rs:2070
msgid "Check the session URL in Server Settings."
msgstr "Ελέγξτε το URL συνεδρίας στις «Ρυθμίσεις διακομιστή»."

