#: app/src/add_account.rs:799 app/src/add_account.rs:1977
#: app/src/add_account.rs:2010 app/src/add_account.rs:2039
#: app/src/add_account.rs:2106
msgid "Could not sign in"
msgstr "Αδύνατη η σύνδεση"

#: app/src/add_account.rs:812 app/src/add_account.rs:1344
msgid "Could not sign in: {reason}"
msgstr "Αδύνατη η σύνδεση: {reason}"

#: app/src/add_account.rs:821
msgid "The outgoing server refused the outgoing password."
msgstr "Ο διακομιστής εξερχομένων απέρριψε τον κωδικό πρόσβασης εξερχομένων."

#: app/src/add_account.rs:824
msgid "The outgoing server refused its password"
msgstr "Ο διακομιστής εξερχομένων απέρριψε τον κωδικό του"

#: app/src/add_account.rs:825
msgid "Check the outgoing password in Server Settings, then choose Sign In."
msgstr ""
"Ελέγξτε τον κωδικό πρόσβασης εξερχομένων στις «Ρυθμίσεις διακομιστή» και "
"επιλέξτε «Σύνδεση»."

#: app/src/add_account.rs:829
msgid "The outgoing server refused the password."
msgstr "Ο διακομιστής εξερχομένων απέρριψε τον κωδικό."

#: app/src/add_account.rs:837
msgid "The incoming server refused the password."
msgstr "Ο διακομιστής εισερχομένων απέρριψε τον κωδικό."

#: app/src/add_account.rs:845
msgid "The server refused the password."
msgstr "Ο διακομιστής απέρριψε τον κωδικό."

#: app/src/add_account.rs:854
msgid "IMAP is off for this account."
msgstr "Το IMAP είναι ανενεργό για αυτόν τον λογαριασμό."

#: app/src/add_account.rs:857
msgid "IMAP is off for this account"
msgstr "Το IMAP είναι ανενεργό για αυτόν τον λογαριασμό"

#: app/src/add_account.rs:860
msgid "Turn on IMAP in {provider}'s settings, then choose Sign In."
msgstr ""
"Ενεργοποιήστε το IMAP στις ρυθμίσεις του {provider} και επιλέξτε «Σύνδεση»."

#: app/src/add_account.rs:863
msgid "Turn on IMAP in your mail settings, then choose Sign In."
msgstr ""
"Ενεργοποιήστε το IMAP στις ρυθμίσεις της αλληλογραφίας σας και επιλέξτε "
"«Σύνδεση»."

#: app/src/add_account.rs:871
msgid "Could not verify the secure connection to {host}."
msgstr "Αδύνατη η επαλήθευση της ασφαλούς σύνδεσης με το {host}."

#: app/src/add_account.rs:875
msgid "Secure connection failed"
msgstr "Η ασφαλής σύνδεση απέτυχε"

#: app/src/add_account.rs:878
msgid ""
"If you use Proton Mail Bridge, export its TLS certificate and follow the "
"setup guide, then try signing in again."
msgstr ""
"Αν χρησιμοποιείτε το Proton Mail Bridge, εξαγάγετε το πιστοποιητικό TLS του "
"και ακολουθήστε τον οδηγό ρύθμισης, και μετά δοκιμάστε να συνδεθείτε ξανά."

#: app/src/add_account.rs:882
msgid "Set Up Proton Mail Bridge"
msgstr "Ρύθμιση του Proton Mail Bridge"

#: app/src/add_account.rs:890
msgid "Could not reach {host}: {reason}"
msgstr "Αδύνατη η σύνδεση με το {host}: {reason}"

#: app/src/add_account.rs:894
msgid "No answer on port {port}"
msgstr "Καμία απάντηση στη θύρα {port}"

#: app/src/add_account.rs:898
msgid ""
"The server did not answer. Check the server name and port, or try again when "
"you are online."
msgstr ""
"Ο διακομιστής δεν απάντησε. Ελέγξτε το όνομα και τη θύρα του διακομιστή ή "
"δοκιμάστε ξανά όταν είστε συνδεδεμένοι."

#: app/src/add_account.rs:918
msgid ""
"{host} answered but turned down another connection. Try again in a few "
"minutes."
msgstr ""
"Το {host} απάντησε αλλά αρνήθηκε μια ακόμη σύνδεση. Δοκιμάστε ξανά σε λίγα "
"λεπτά."

#: app/src/add_account.rs:922
msgid "Too many connections"
msgstr "Πάρα πολλές συνδέσεις"

#: app/src/add_account.rs:928
msgid "{host} answered in a way this app cannot work with."
msgstr ""
"Το {host} απάντησε με τρόπο που αυτή η εφαρμογή δεν μπορεί να χειριστεί."

#: app/src/add_account.rs:939
msgid "This app cannot send these sign-in details to the server."
msgstr ""
"Αυτή η εφαρμογή δεν μπορεί να στείλει αυτά τα στοιχεία σύνδεσης στον "
"διακομιστή."

#: app/src/add_account.rs:955
msgid ""
"Penguin Mail cannot save your sign-in until the snap can reach your keyring. "
"Run this command in a terminal, restart Penguin Mail, then add the account "
"again."
msgstr ""
"Το Penguin Mail δεν μπορεί να αποθηκεύσει τη σύνδεσή σας μέχρι το snap να "
"αποκτήσει πρόσβαση στην κλειδοθήκη σας. Εκτελέστε αυτή την εντολή σε ένα "
"τερματικό, επανεκκινήστε το Penguin Mail και προσθέστε ξανά τον λογαριασμό."

#: app/src/add_account.rs:960
msgid "Connect Your Keyring"
msgstr "Σύνδεση της κλειδοθήκης σας"

#: app/src/add_account.rs:989 app/src/add_account.rs:2052
msgid "{provider} refused the password"
msgstr "Το {provider} απέρριψε τον κωδικό"

#: app/src/add_account.rs:992
msgid "The server refused the password"
msgstr "Ο διακομιστής απέρριψε τον κωδικό"

#: app/src/add_account.rs:1000
msgid ""
"{provider} wants an app password here, not your website password. Make one, "
"paste it above, then choose Sign In."
msgstr ""
"Το {provider} θέλει εδώ κωδικό εφαρμογής, όχι τον κωδικό του ιστοτόπου. "
"Δημιουργήστε έναν, επικολλήστε τον παραπάνω και επιλέξτε «Σύνδεση»."

#: app/src/add_account.rs:1004 app/src/add_account.rs:2053
msgid "Check the password, then choose Sign In."
msgstr "Ελέγξτε τον κωδικό και επιλέξτε «Σύνδεση»."

#: app/src/add_account.rs:1021
msgid "The server said: {reason}"
msgstr "Ο διακομιστής απάντησε: {reason}"

#: app/src/add_account.rs:1041
msgid "Make an App Password"
msgstr "Δημιουργία κωδικού εφαρμογής"

#: app/src/add_account.rs:1045
msgid "Turn On IMAP"
msgstr "Ενεργοποίηση IMAP"

#: app/src/add_account.rs:1191
msgid "{host} is not a server name."
msgstr "Το {host} δεν είναι όνομα διακομιστή."

#: app/src/add_account.rs:1197
msgid "Type the incoming server's name."
msgstr "Πληκτρολογήστε το όνομα του διακομιστή εισερχομένων."

#: app/src/add_account.rs:1198
msgid "Type the outgoing server's name."
msgstr "Πληκτρολογήστε το όνομα του διακομιστή εξερχομένων."

#: app/src/add_account.rs:1345
msgid "Could not add the calendar: {reason}"
msgstr "Αδύνατη η προσθήκη του ημερολογίου: {reason}"

#: app/src/add_account.rs:1360
msgid ""
"To see this server's calendars there, open Preferences, then Accounts, open "
"that account, and type this server's address under Calendar, Contacts and "
"Rules Servers."
msgstr ""
"Για να δείτε εκεί τα ημερολόγια αυτού του διακομιστή, ανοίξτε τις "
"«Προτιμήσεις», μετά τους «Λογαριασμούς», ανοίξτε εκείνον τον λογαριασμό και "
"πληκτρολογήστε τη διεύθυνση αυτού του διακομιστή στους «Διακομιστές "
"ημερολογίου, επαφών και κανόνων»."

#: app/src/add_account.rs:1373
msgid ""
"The server did not take that user name and password. Where it uses two-step "
"sign-in, it needs an app password."
msgstr ""
"Ο διακομιστής δεν δέχτηκε αυτό το όνομα χρήστη και τον κωδικό. Αν "
"χρησιμοποιεί σύνδεση δύο βημάτων, χρειάζεται κωδικό εφαρμογής."

#: app/src/add_account.rs:1377
msgid ""
"Penguin Mail could not reach that server. Check the address and your "
"connection."
msgstr ""
"Το Penguin Mail δεν μπόρεσε να συνδεθεί με αυτόν τον διακομιστή. Ελέγξτε τη "
"διεύθυνση και τη σύνδεσή σας."

#: app/src/add_account.rs:1382
msgid "No calendar was found at that address."
msgstr "Δεν βρέθηκε ημερολόγιο σε αυτή τη διεύθυνση."

#: app/src/add_account.rs:1403
msgid "Mail is downloading. You can close this window."
msgstr "Γίνεται λήψη της αλληλογραφίας. Μπορείτε να κλείσετε αυτό το παράθυρο."

#: app/src/add_account.rs:1404 app/src/add_account.rs:1433
msgid "Your mail is here."
msgstr "Η αλληλογραφία σας έφτασε."

#: app/src/add_account.rs:1418
msgid ""
"Your organization did not allow one of the permissions Penguin Mail asked "
"for, so this feature stays off:"
msgid_plural ""
"Your organization did not allow {count} of the permissions Penguin Mail "
"asked for, so these features stay off:"
msgstr[0] ""
"Ο οργανισμός σας δεν επέτρεψε μία από τις άδειες που ζήτησε το Penguin Mail, "
"οπότε αυτή η λειτουργία παραμένει ανενεργή:"
msgstr[1] ""
"Ο οργανισμός σας δεν επέτρεψε {count} από τις άδειες που ζήτησε το Penguin "
"Mail, οπότε αυτές οι λειτουργίες παραμένουν ανενεργές:"

#: app/src/add_account.rs:1425
msgid "You left one box unticked on Google's page, so this feature stays off:"
msgid_plural ""
"You left {count} boxes unticked on Google's page, so these features stay off:"
msgstr[0] ""
"Αφήσατε ένα πλαίσιο χωρίς σημάδι στη σελίδα της Google, οπότε αυτή η "
"λειτουργία παραμένει ανενεργή:"
msgstr[1] ""
"Αφήσατε {count} πλαίσια χωρίς σημάδι στη σελίδα της Google, οπότε αυτές οι "
"λειτουργίες παραμένουν ανενεργές:"

#: app/src/add_account.rs:1432
msgid "Mail is downloading."
msgstr "Γίνεται λήψη της αλληλογραφίας."

#: app/src/add_account.rs:1452
msgid ""
"Newest mail comes first. Older mail keeps coming in the background, even "
"with the window closed."
msgstr ""
"Τα νεότερα μηνύματα έρχονται πρώτα. Τα παλαιότερα συνεχίζουν να έρχονται στο "
"παρασκήνιο, ακόμη και με το παράθυρο κλειστό."

#: app/src/add_account.rs:1455
msgid "Penguin Mail keeps checking for new mail, even with the window closed."
msgstr ""
"Το Penguin Mail συνεχίζει να ελέγχει για νέα μηνύματα, ακόμη και με το "
"παράθυρο κλειστό."

#: app/src/add_account.rs:1466
msgid ""
"Penguin Mail downloads the server's mail into Inbox and keeps checking in "
"the background, even with the window closed. Mail stays on the server."
msgstr ""
"Το Penguin Mail κατεβάζει την αλληλογραφία του διακομιστή στα Εισερχόμενα "
"και συνεχίζει να ελέγχει στο παρασκήνιο, ακόμη και με το παράθυρο κλειστό. Η "
"αλληλογραφία παραμένει στον διακομιστή."

#: app/src/add_account.rs:1469
msgid ""
"Penguin Mail downloads the server's mail into Inbox and keeps checking in "
"the background, even with the window closed. It removes each message from "
"the server after downloading it."
msgstr ""
"Το Penguin Mail κατεβάζει την αλληλογραφία του διακομιστή στα Εισερχόμενα "
"και συνεχίζει να ελέγχει στο παρασκήνιο, ακόμη και με το παράθυρο κλειστό. "
"Αφαιρεί κάθε μήνυμα από τον διακομιστή μετά τη λήψη του."

#: app/src/add_account.rs:1472
msgid ""
"Penguin Mail downloads the server's mail into Inbox and keeps checking in "
"the background, even with the window closed. It removes each message from "
"the server {days} day after downloading it."
msgid_plural ""
"Penguin Mail downloads the server's mail into Inbox and keeps checking in "
"the background, even with the window closed. It removes each message from "
"the server {days} days after downloading it."
msgstr[0] ""
"Το Penguin Mail κατεβάζει την αλληλογραφία του διακομιστή στα Εισερχόμενα "
"και συνεχίζει να ελέγχει στο παρασκήνιο, ακόμη και με το παράθυρο κλειστό. "
"Αφαιρεί κάθε μήνυμα από τον διακομιστή {days} ημέρα μετά τη λήψη του."
msgstr[1] ""
"Το Penguin Mail κατεβάζει την αλληλογραφία του διακομιστή στα Εισερχόμενα "
"και συνεχίζει να ελέγχει στο παρασκήνιο, ακόμη και με το παράθυρο κλειστό. "
"Αφαιρεί κάθε μήνυμα από τον διακομιστή {days} ημέρες μετά τη λήψη του."

#: app/src/add_account.rs:1488
msgid "Penguin Mail needs the password for {address} again."
msgstr "Το Penguin Mail χρειάζεται ξανά τον κωδικό για το {address}."

#: app/src/add_account.rs:1497
msgid "Choose Sign In With Browser to sign in to {address} again."
msgstr ""
"Επιλέξτε «Σύνδεση μέσω προγράμματος περιήγησης» για να συνδεθείτε ξανά στο "
"{address}."

#: app/src/add_account.rs:1506
msgid "Sign in again through the browser to keep {account} syncing"
msgstr ""
"Συνδεθείτε ξανά μέσω του προγράμματος περιήγησης για να συνεχίσει ο "
"συγχρονισμός του {account}"

#: app/src/add_account.rs:1507
msgid "Sign in again to keep {account} syncing"
msgstr "Συνδεθείτε ξανά για να συνεχίσει ο συγχρονισμός του {account}"

#: app/src/add_account.rs:1637
